#include <iostream>
#include <string>
#define MAX_DISH 20
#define MAX_USER 500
#define MAX_ORDER 1000
using namespace std;
struct Dish {
    int id;
    string name;
    double price;
    int stock;
};
struct User {
    string id;
    string name;
    string pwd;
    int grade;
    string major;
    string birth;
    string number;
    int money;
};
